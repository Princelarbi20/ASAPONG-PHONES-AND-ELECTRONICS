# Required in Render (set real values in the service environment, not this file)
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_SECRET=use-a-different-random-secret-at-least-32-characters
REFRESH_TOKEN_EXPIRE=7d
FRONTEND_ORIGIN=https://your-frontend-domain.example
PAYSTACK_SECRET_KEY=sk_live_replace-me
PAYSTACK_BASE_URL=https://api.paystack.co

# Required by registration, OTP resend, suspension notices, and order emails
EMAIL_USER=your-sender@example.com
EMAIL_PASS=your-email-provider-app-password

# Required in production for durable product and private dealer certificate uploads.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_LOG=
# Required in production and must be an origin listed in FRONTEND_ORIGIN.
CLIENT_URL=https://your-frontend-domain.example
